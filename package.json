{
  "name": "highline-video-analysis",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/inline-build.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
