    "assets": "node scripts/prepare-pose-assets.mjs",
    "predev": "npm run -s assets",
    "prebuild": "npm run -s assets"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  }
